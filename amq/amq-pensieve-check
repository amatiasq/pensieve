#!/bin/bash -e

# amq pensieve check — full local CI check for pensieve.
#
# Mirrors .github/workflows/ci-pensieve.yml so a green CI run and a local
# `amq pensieve check` cannot diverge:
#   install deps (bun) + lint (eslint) + typecheck (tsc) + build (vite), and
#   typecheck and test the API (deno check, deno test).
#
# Two runtimes because the project is two things: the app is Bun + Vite and the
# API is Deno, which is what the VPS can run (its CPU has no AVX2).
#
# The e2e suite is NOT here: it needs browsers and takes minutes, so it lives in
# `amq pensieve test`. Install is skipped when node_modules is already present so
# repeated local runs stay fast; CI has no node_modules and installs fresh.

if [ ! -d node_modules ]; then
  echo "==> bun install"
  bun install
else
  echo "==> deps present, skipping bun install"
fi

echo "==> lint (eslint)"
bunx eslint .

echo "==> typecheck app (tsc --noEmit)"
bunx tsc --noEmit -p tsconfig.json

echo "==> typecheck api (deno check)"
deno check --config api/deno.json api/index.ts

echo "==> test api (deno test)"
deno test --config api/deno.json api/

echo "==> build (vite)"
bunx vite build
