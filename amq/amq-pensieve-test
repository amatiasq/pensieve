#!/bin/bash -e
# amq pensieve test [args de playwright] — the Playwright e2e suite (14 specs,
# 79 tests, desktop + mobile). Extra args go straight to `playwright test`.
#
# Runs against `vite preview`, not the dev server: the build is what ships, and
# it is where the dead emotion CSS hid for four months. Playwright builds and
# starts the servers itself, so `dist/` cannot go stale under the suite.
#
# No OAuth needed: `e2e/fixtures.ts` intercepts `/auth` and serves a repo mock
# from memory, so the suite runs offline.
#
# Same command in CI: .github/workflows/ci-pensieve.yml, job `e2e`.

case "$1" in
  -h|--help|help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/, ""); print}' "$0"; exit 0;;
esac

if [ ! -d node_modules ]; then
  echo "==> bun install"
  bun install
fi

echo "==> playwright install (chromium)"
bunx playwright install --with-deps chromium

echo "==> e2e (playwright)"
exec bunx playwright test "$@"
