#!/bin/bash -e
# amq pensieve search <término> — busca notas por su nombre y escribe una línea
# por cada una: el título tal cual, y detrás su id (lo que enlaza con la web:
# https://github.com/amatiasq/pensieve-data/blob/main/note/<id>). Sin
# distinguir mayúsculas.
#
# Una nota es un fichero de pensieve-data cuya primera línea es su nombre, así
# que buscar es mirar primeras líneas — con el repo clonado no hace falta la
# web. Como el grupo es la parte izquierda de la `/` en esa misma línea, buscar
# por grupo (`amq pensieve search recetas/`) sale gratis.
#
# El clon vive en PENSIEVE_CACHE y se crea la primera vez; las siguientes sólo
# se actualiza. Es caché, no backup: backups/pensieve-data.git es de `amq
# pensieve backup` y este comando no lo toca. Leer una nota entera es `amq
# pensieve view <id>`; editarla, `amq pensieve edit <id>`.
#
# Config (env):
#   PENSIEVE_DATA_REPO   repo de notas (el mismo que lee amq pensieve backup)
#   PENSIEVE_CACHE       dónde clonarlo (default /tmp/pensieve-data)

case "$1" in
  -h|--help|help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/, ""); print}' "$0"; exit 0;;
  '') awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/, ""); print}' "$0" >&2; exit 1;;
esac

source "$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/lib/pensieve-data.sh"

term="$1"
CACHE="${PENSIEVE_CACHE:-/tmp/pensieve-data}"

pensieve_data_clone "$CACHE"

if [ -t 1 ] && [ -z "$NO_COLOR" ]; then
  DIM=$'\033[2m'; OFF=$'\033[0m'
else
  DIM=''; OFF=''
fi

# Una pasada de awk por lote en vez de un `head` por nota: con miles, minutos.
# El título se limpia al imprimir (la primera línea puede venir comentada);
# sólo la parte visible de `getMetadataFromContent`, con los marcadores de
# COMMENTS_BY_LANG en src/2-entities/getMetadataFromContent.ts. Escribir
# metadata no se duplica así: eso es `amq pensieve edit`, que llama a la de
# verdad.
find "$CACHE/note" -type f -print0 \
  | xargs -0 awk -v term="$term" -v dim="$DIM" -v off="$OFF" '
      FNR != 1 { nextfile }

      index(tolower($0), tolower(term)) {
        title = $0
        sub(/^[ \t]+/, "", title)
        sub(/^(<!--|\/\/|%%|--|#)[ \t]*/, "", title)
        sub(/[ \t]*-->[ \t]*$/, "", title)

        id = FILENAME
        sub(/.*\//, "", id)

        print title "  " dim id off
      }
    ' \
  | sort
