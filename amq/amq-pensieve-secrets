#!/bin/bash -e

# amq pensieve secrets — escribe el `.env` del stack de pensieve en el VPS.
#
# Son los dos secretos de las OAuth Apps de GitHub, el de desarrollo y el de
# producción. Sin ellos el contenedor de la API no arranca, a propósito: si el
# login falla la app no carga, y eso es mejor verlo al desplegar.
#
#   CLIENT_SECRET_DEV    OAuth App de localhost (client_id c55d2c46…)
#   CLIENT_SECRET_PROD   OAuth App de pensieve.amatiasq.com (client_id 09580e62…)
#
# El `.env` del servidor no sube por rsync (`amq vps deploy` lo excluye) y no
# está en el repo. Ver ../../infra/.agents/plans/secretos-en-1password.md.
#
# Config (env):
#   PENSIEVE_OP_ITEM   item de 1Password con los dos campos (obligatorio)
#   VPS_REMOTE_DIR     default vps

VPS_REMOTE_DIR="${VPS_REMOTE_DIR:-vps}"
DIR="~/$VPS_REMOTE_DIR/docker/pensieve"
DEST="$DIR/.env"
# `Pensieve / .env`, no `Pensieve`: hay dos items y el otro es el login de la web,
# sin estos campos. Con el id equivocado esto falla cerrado y lo dice, que es lo
# que pasaba.
PENSIEVE_OP_ITEM="w64hsw3jhs4gd44ixnupel27qi"

field() {
  amq op item get "$PENSIEVE_OP_ITEM" --fields "label=$1" | jq -r '.value'
}

DEV="$(field CLIENT_SECRET_DEV)"
PROD="$(field CLIENT_SECRET_PROD)"

for pair in "CLIENT_SECRET_DEV:$DEV" "CLIENT_SECRET_PROD:$PROD"; do
  if [[ -z "${pair#*:}" || "${pair#*:}" == "null" ]]; then
    echo "El item $PENSIEVE_OP_ITEM no tiene un campo ${pair%%:*} con valor." >&2
    exit 1
  fi
done

echo "==> escribiendo $DEST"
{
  echo "CLIENT_SECRET_DEV=$DEV"
  echo "CLIENT_SECRET_PROD=$PROD"
} | amq vps ssh "mkdir -p $DIR && cat > $DEST && chmod 600 $DEST"

echo "==> listo. Comprueba con: amq vps ssh 'ls -l $DEST'"
