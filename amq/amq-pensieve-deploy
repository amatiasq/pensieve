#!/bin/bash -e
# amq pensieve deploy [--skip-build] — construye aquí, y pone en producción la
# app y la API.
#
#   --skip-build   sube el dist/ que ya está construido
#
# Son dos mitades en dos stacks: la imagen de la API, que corre sola en la red
# `pensieve_internal`, y el `dist/` de la app, que sirve el nginx común de
# `services/nginx-static` — el mismo que se une a esa red para llevarle /auth,
# /commit y /tarball a la API. El `dist/` va al docroot del nginx que esté
# sirviendo, que es el común salvo en la vuelta atrás.
#
# El build se hace aquí y no en el VPS: es Bun + Vite y la CPU del VPS no tiene
# AVX2. Al servidor sólo llega `dist/`.

case "$1" in
  -h|--help|help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/, ""); print}' "$0"; exit 0;;
esac

amq need bun docker

IMAGE="docker.amatiasq.com/pensieve-api"
SERVICE="pensieve"
STAMP="$(date +%Y-%m-%dT%H-%M-%S)"
VPS_REMOTE_DIR=vps

cd "$(dirname "$0")/.."

# Fail-closed y antes de construir nada: sin los secretos de la OAuth App el
# contenedor de la API no arranca, y si el login falla la app no carga.
for secret in CLIENT_SECRET_DEV CLIENT_SECRET_PROD; do
  if ! amq vps ssh "grep -q '^$secret=' ~/$VPS_REMOTE_DIR/docker/$SERVICE/.env" 2>/dev/null; then
    echo "Falta $secret en ~/$VPS_REMOTE_DIR/docker/$SERVICE/.env; la API no arrancaría." >&2
    echo "Ponlos con: amq pensieve secrets" >&2
    exit 1
  fi
done

if [[ "$1" != "--skip-build" ]]; then
  if [ ! -d node_modules ]; then
    echo "==> bun install"
    bun install
  fi

  echo "==> build"
  bun run build
fi

[ -f dist/index.html ] || { echo "no dist/index.html — nada que desplegar" >&2; exit 1; }

# `dist/` está gitignorado, así que sin esto no se sabe qué corre en producción.
# El sufijo -dirty lo decide `git status`: un build de un árbol sucio no es el
# commit que dice ser.
echo "==> estampar versión"
commit="$(git rev-parse HEAD)"
[ -z "$(git status --porcelain -- . ':!dist')" ] || commit="$commit-dirty"
printf '%s\n%s\n' "$commit" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > dist/version.txt
echo "    $commit"

# El disco del VPS es muy pequeño y `dist/` trae monaco-editor: el tamaño se
# imprime siempre, para que crecer de golpe se vea antes de subirlo.
echo "==> dist/ pesa $(du -sh dist | cut -f1)"

# La imagen se construye para linux/amd64 (esta máquina es arm64) y se etiqueta
# también con la fecha, para poder volver atrás.
echo "==> construir la imagen de la API (linux/amd64)"
docker buildx build --platform linux/amd64 --pull \
  -f api/Dockerfile -t "$IMAGE:latest" -t "$IMAGE:$STAMP" .

echo "==> subir la imagen"
docker push "$IMAGE:latest"
docker push "$IMAGE:$STAMP"

# El docroot lo decide qué nginx está arriba, no el repo: desde el 2026-09-18
# sirve el común de `services/nginx-static` y la rama de abajo es la vuelta
# atrás, que arranca otra vez el nginx por sitio.
if amq vps ssh 'docker ps --format "{{.Names}}"' | grep -qx nginx-static; then
  SITE_DIR="$VPS_REMOTE_DIR/docker/nginx-static/www/pensieve"
  shared_nginx=1
else
  SITE_DIR="$VPS_REMOTE_DIR/docker/pensieve/www"
  shared_nginx=0
fi
echo "==> docroot: $SITE_DIR"

# Con --delete: aquí todo es generado, y una ruta que dejó de construirse debe
# dejar de servirse. Apunta a `www/pensieve/`, nunca a `www/`, que es de once
# sitios.
echo "==> rsync dist/ -> $SITE_DIR/ en el VPS"
amq vps ssh "mkdir -p '$SITE_DIR'"
amq vps rsync --delete dist/ ":$SITE_DIR/"

# La API primero: es quien crea la red `pensieve_internal` a la que el nginx
# común se une.
amq services deploy "$SERVICE" --from infra

# El nginx por sitio lee su nginx.conf del servidor y no necesita nada; el
# común sí, que su routing —y el proxy a la API— viaja aquí.
if [ "$shared_nginx" = 1 ]; then
  amq nginx-static deploy
fi

echo "==> desplegado: https://pensieve.amatiasq.com/ ($commit)"
