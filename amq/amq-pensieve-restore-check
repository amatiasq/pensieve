#!/bin/bash -e
# amq pensieve restore-check [bundle] — prueba que un bundle restaura, y borra
# lo restaurado. Clona un bundle de backups/ (el más reciente si no se da) en
# un temporal, comprueba que trae commits y ficheros, y lo borra.
#
# `amq pensieve restore` ya es inofensivo —clona, no publica—, así que esto es
# el mismo trabajo contra un temporal más la afirmación que convierte el ensayo
# en una prueba: **un repo con cero commits o cero ficheros no es una copia**, y
# clonar un bundle vacío sale 0.

case "$1" in
  -h|--help|help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/, ""); print}' "$0"; exit 0;;
esac

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

amq pensieve restore "${1:-}" "$tmp/repo"

commits="$(git -C "$tmp/repo" rev-list --count HEAD)"
files="$(git -C "$tmp/repo" ls-files | wc -l | tr -d ' ')"

if [[ "$commits" -eq 0 || "$files" -eq 0 ]]; then
  echo "El bundle clona pero no trae nada: commits=$commits ficheros=$files" >&2
  exit 1
fi
